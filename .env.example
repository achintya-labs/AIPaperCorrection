# Sign-in. "sso" (default): the gateway (Caddy + WAF + Tinyauth, users in LLDAP) signs people in; roles come from LDAP groups.
# "local": the app's own password / Google sign-in behind the nginx HTTPS proxy (development, break-glass).
AUTH_MODE=sso
# run.sh keeps COMPOSE_PROFILES equal to AUTH_MODE, so a bare `podman-compose up` also starts the right services (but use ./run.sh up: it also does the setup).
# COMPOSE_PROFILES=sso

# Grader backend: claude_runner (dedicated `claude` container, default) | claude_cli (CLI in this
# process) | anthropic_api (stub) | fake (no API calls, for trying the UI)
GRADER_PROVIDER=claude_runner
CLAUDE_MODEL=claude-sonnet-5-5
# Optional lighter model for PDF auto-split analysis (defaults to CLAUDE_MODEL when empty)
CLAUDE_SPLIT_MODEL=haiku
# Auto-split shows Claude the top part of every page (roll numbers are normally there): 0.4 = the top 40%.
# Raise it (up to 1.0) if your papers put the roll number lower; fewer pages then fit on each image.
# SPLIT_TOP_FRACTION=0.4
GRADER_TIMEOUT_SECONDS=600
WORKER_CONCURRENCY=2

# Shared secret between api/worker and the `claude` container. Generate: openssl rand -hex 32
CLAUDE_RUNNER_TOKEN=

# Claude auth lives in the `claude` container. Normally just run ./scripts/claude-login.sh once.
# Optional alternatives (leave empty to use that login):
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# Telemetry from the `claude` container (OpenTelemetry to your own collector). Off by default.
# Exports usage metrics (sessions, tokens, cost, active time); prompts/student work are NOT exported.
# Account fields (email, account/org id) are included by default.
CLAUDE_CODE_ENABLE_TELEMETRY=0
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.com
# OTEL_EXPORTER_OTLP_PROTOCOL=http/json
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <token>
# OTEL_RESOURCE_ATTRIBUTES=service.name=paper-grader-claude,deployment.environment=prod
# OTEL_LOGS_EXPORTER=otlp          # also export event logs (default: none)

# API
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:4321
DB_PASSWORD=grader

# Sign in with Google (optional; set all three). Only existing users can sign in this way.
# Create an OAuth client of type "Web application" in Google Cloud Console and add
#   <PUBLIC_BASE_URL>/api/auth/google/callback
# as an authorized redirect URI. PUBLIC_BASE_URL is the address users browse to (https in production).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_BASE_URL=

# First admin. sso: BOOTSTRAP_ADMIN_EMAIL is the email of LLDAP's built-in `admin` user (password: LLDAP_ADMIN_PASSWORD below),
# who is put in the admin group. local: created on startup if no users exist, with BOOTSTRAP_ADMIN_PASSWORD.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me

# --- sso mode (run.sh generates and fills these) ---
# People browse to https://<DOMAIN>:<HTTPS_PORT>; the login portal is auth.<DOMAIN>, user management lldap.<DOMAIN>.
# <DOMAIN> needs at least two labels (lan.internal is fine: Caddy issues certificates from its own CA for .internal names;
# every browser machine needs /etc/hosts entries for the three names). Rootless Podman can't publish ports below 1024.
# DOMAIN=lan.internal
# PUBLIC_PORT=443                     the port PEOPLE use when it differs from HTTPS_PORT (the port the gateway is published on), e.g. an nginx in front
#                                       listening on 443. Blank = HTTPS_PORT. 443 is left out of URLs. run.sh then derives AUTH_URL, LOGOUT_URL, LDAP_ADMIN_URL
#                                       and PUBLIC_BASE_URL from it. The proxy must pass the Host header (with its port) and use HTTPS to this gateway.
# EXTRA_DOMAINS=grader.other.org,papers.example.com:8443   more, UNRELATED domains that serve the same app (blank = none). Each gets its own login
#                                       portal auth.<name> (its own Tinyauth: a login cookie can't span unrelated domains), a certificate entry
#                                       and an ALLOWED_HOSTS entry; run.sh does all three. People sign in separately on each domain. A subdomain
#                                       Each entry may add ":port" for the port people use on that domain (default PUBLIC_PORT). A subdomain
#                                       of DOMAIN is not an extra domain: just add it to ALLOWED_HOSTS. Set with ./run.sh --extra-domains a.org,b.org
# HTTPS_BIND=0.0.0.0              interface the gateway listens on
# ACME_EMAIL=admin@example.com    only used for public domains (Let's Encrypt)
# Where "Log out" and the Admin page's "Manage in LLDAP" link go (run.sh sets both):
# LOGOUT_URL=https://auth.lan.internal:5904/logout
# LDAP_ADMIN_URL=https://lldap.lan.internal:5904
# LDAP directory (LLDAP, stored in the app's Postgres in a separate `lldap` database):
# LDAP_BASE_DN=dc=example,dc=com
# LDAP_ADMIN_GROUP=papergrader_admins   members are admins
# LDAP_TA_GROUP=papergrader_tas         members are TAs; anyone in neither group is "not enrolled"
# LLDAP_ADMIN_USERS=admin               regex of the user ids allowed to open the LLDAP UI at all (admin|alice); list every account in
#                                       LLDAP's lldap_admin group. Everyone else gets a 403 page at lldap.<DOMAIN>
# LDAP_OBSERVER_USER=tinyauth_observer  read-only account the app and Tinyauth bind with
# LDAP_OBSERVER_PASSWORD=
# LLDAP_ADMIN_PASSWORD=
# LLDAP_JWT_SECRET=
# LLDAP_KEY_SEED=
# LLDAP_DB_PASSWORD=
# Login screen wording (defaults shown):
# LOGIN_TITLE=Paper Grader
# LOGIN_FORGOT_MESSAGE=Ask the administrator to reset your password.
# Optional: break-glass Tinyauth users (user:bcrypt_hash, $ escaped as $$), Google sign-in at the gateway:
# TINYAUTH_USERS=
# OAUTH_WHITELIST=you@gmail.com,@school.edu
# (GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above are then used by Tinyauth, redirect URI https://auth.<DOMAIN>:<HTTPS_PORT>/api/oauth/callback/google)

# Web: hostname(s) users browse to, comma-separated, "*.example.com" allowed (read at runtime: just restart web).
# Behind HTTPS, terminate TLS in a reverse proxy that forwards Host and X-Forwarded-Proto,
# and set COOKIE_SECURE=true.
ALLOWED_HOSTS=localhost,127.0.0.1
COOKIE_SECURE=false

# The one published HTTPS port. sso: the gateway (`caddy`), default 5904. local: the nginx `proxy` (run.sh writes 8443):
#   ./scripts/make-cert.sh <your-host-or-ip>, add that host to ALLOWED_HOSTS, COOKIE_SECURE=true, PUBLIC_BASE_URL=https://<host>:<HTTPS_PORT>
# Rootless podman cannot bind below 1024; use 443 only where allowed.
HTTPS_PORT=5904

# Which images compose uses. In a git checkout: built locally. A release bundle's compose file already points at the
# published "latest" images; to override (or pin a version) by hand:
# PAPERGRADER_REGISTRY=ghcr.io/<owner>/<repo>
# PAPERGRADER_TAG=latest
