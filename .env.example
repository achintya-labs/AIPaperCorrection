# Grader backend: claude_runner (dedicated `claude` container, default) | claude_cli (CLI in this
# process) | anthropic_api (stub) | fake (no API calls, for trying the UI)
GRADER_PROVIDER=claude_runner
CLAUDE_MODEL=claude-sonnet-5-5
# Optional lighter model for PDF auto-split analysis (defaults to CLAUDE_MODEL when empty)
CLAUDE_SPLIT_MODEL=haiku
GRADER_TIMEOUT_SECONDS=600
WORKER_CONCURRENCY=2

# Shared secret between api/worker and the `claude` container. Generate: openssl rand -hex 32
CLAUDE_RUNNER_TOKEN=

# Claude auth lives in the `claude` container. Normally just run ./scripts/claude-login.sh once.
# Optional alternatives (leave empty to use that login):
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# Telemetry from the `claude` container (OpenTelemetry to your own collector). Off by default.
# Exports usage metrics (sessions, tokens, cost, active time); prompts/student work are NOT exported.
# Account fields (email, account/org id) are included by default.
CLAUDE_CODE_ENABLE_TELEMETRY=0
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.com
# OTEL_EXPORTER_OTLP_PROTOCOL=http/json
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <token>
# OTEL_RESOURCE_ATTRIBUTES=service.name=paper-grader-claude,deployment.environment=prod
# OTEL_LOGS_EXPORTER=otlp          # also export event logs (default: none)

# API
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:4321
DB_PASSWORD=grader

# Sign in with Google (optional; set all three). Only existing users can sign in this way.
# Create an OAuth client of type "Web application" in Google Cloud Console and add
#   <PUBLIC_BASE_URL>/api/auth/google/callback
# as an authorized redirect URI. PUBLIC_BASE_URL is the address users browse to (https in production).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_BASE_URL=

# First admin, created on startup if no users exist
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me

# Web: hostname(s) users browse to, comma-separated, "*.example.com" allowed (read at runtime: just restart web).
# Behind HTTPS, terminate TLS in a reverse proxy that forwards Host and X-Forwarded-Proto,
# and set COOKIE_SECURE=true.
ALLOWED_HOSTS=localhost,127.0.0.1
COOKIE_SECURE=false

# HTTPS reverse proxy (the `proxy` service, the only one published to the network).
# 1. ./scripts/make-cert.sh <your-host-or-ip>   (self-signed; swap certs/tls.crt + tls.key for a real one later)
# 2. add that host to ALLOWED_HOSTS above, set COOKIE_SECURE=true, and PUBLIC_BASE_URL=https://<host>:<HTTPS_PORT>
# Rootless podman cannot bind below 1024, so the default is 8443; use 443 where allowed.
HTTPS_PORT=8443

# Which images compose uses. Default: build locally. To run published images instead:
# PAPERGRADER_REGISTRY=ghcr.io/<owner>/<repo>
# PAPERGRADER_TAG=1.0.0

# --- Native mode (./run.sh --native: no containers). run.sh writes these for you; they are ignored by compose. ---
# NATIVE_DB=sqlite            sqlite (one file in ./data, no database server) or postgres (then set DATABASE_URL)
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
# NATIVE_HTTPS=1              1: HTTPS through proxy/tls-proxy.mjs (default); 0: plain HTTP on NATIVE_PORT
# NATIVE_PORT=4321            plain-HTTP port (and the web server's local port behind the HTTPS proxy)
