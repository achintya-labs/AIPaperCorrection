---
import "../styles.css";
import DialogHost from "../components/DialogHost";
import { can } from "../lib/access";

interface Props { title: string; wide?: boolean }
const { title, wide = false } = Astro.props;
const user = Astro.locals.user;
const path = Astro.url.pathname;
const sso = (process.env.AUTH_MODE ?? "sso") !== "local";
const logoutUrl = process.env.LOGOUT_URL ?? "";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Paper Grader</title>
  </head>
  <body>
    {user && (
      <header class="topbar">
        <a class="brand" href="/">
          <img src="/favicon.svg" alt="" width="22" height="22" />
          <span>Paper Grader</span>
        </a>
        <nav>
          <a href="/" aria-current={path === "/" ? "page" : undefined}>My queue</a>
          {can(user.permissions, "exams.view") && (
            <a href="/admin/exams" aria-current={path.startsWith("/admin/exams") ? "page" : undefined}>Exams</a>
          )}
          {user.role === "admin" && (
            <a href="/admin/users" aria-current={path.startsWith("/admin/users") ? "page" : undefined}>Admin</a>
          )}
        </nav>
        <div class="topbar-end">
          <a class="me" href="/account" aria-current={path === "/account" ? "page" : undefined} title="Account and password">
            <span class="person">
              <span class="person-name">{user.name?.trim() || user.email}</span>
              {user.name?.trim() && <span class="person-email">{user.email}</span>}
            </span>
            <span class="badge neutral">{user.role === "admin" ? "Admin" : "TA"}</span>
          </a>
          {!sso && <button id="logout">Log out</button>}
          {sso && logoutUrl && <a class="btn" href={logoutUrl}>Log out</a>}
        </div>
      </header>
    )}
    <main class:list={["container", { wide }]}>
      <slot />
    </main>
    <DialogHost client:load />
    <script>
      document.getElementById("logout")?.addEventListener("click", async () => {
        // Content-Type is required here: body-less POSTs without one fail Astro's origin check.
        await fetch("/api/auth/logout", { method: "POST", headers: { "content-type": "application/json" } });
        window.location.href = "/login";
      });
    </script>
  </body>
</html>
