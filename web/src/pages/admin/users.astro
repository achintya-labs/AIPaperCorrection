---
import Layout from "../../layouts/Layout.astro";
import Users from "../../components/Users";
import ModelUsage from "../../components/ModelUsage";
---
<Layout title="Admin">
  <h1>Admin</h1>
  <div class="admin-sections">
    <ModelUsage client:load />
    <Users sso={(process.env.AUTH_MODE ?? "sso") !== "local"} ldapAdminUrl={process.env.LDAP_ADMIN_URL ?? ""} client:load />
  </div>
</Layout>
