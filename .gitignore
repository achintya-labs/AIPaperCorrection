# secrets and local configuration
.env
.env.*
!.env.example
.mcp.json

# local tooling (each developer's own)
.venv/
.claude/
.idea/
.vscode/

# python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# node / astro
node_modules/
dist/
.astro/

# TLS certificate and key for the reverse proxy (local mode) and any custom certificate for the gateway (sso mode)
certs/
gateway/tls/*
!gateway/tls/.gitkeep

# generated by run.sh from EXTRA_DOMAINS (the extra domains' Caddy sites and login portals)
gateway/sites/*
!gateway/sites/.gitkeep
docker-compose.domains.yml

# users exported from an older install for the LDAP bootstrap (contains emails)
ldap-bootstrap/

# runtime data (anchored: an unanchored "storage/" also hid the api/app/storage Python package from git,
# which broke CI with "No module named app.storage")
/storage/
/api/storage/
*.db
*.sqlite3

# Extras
EE2003*
