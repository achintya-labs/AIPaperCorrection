# The only service published on the network (HTTPS_PORT, default 5904). Order of handling for the app:
#   Coraza WAF (OWASP CRS)  ->  Tinyauth forward_auth (login, LDAP / Google)  ->  web
# Tinyauth sets Remote-User, Remote-Name and Remote-Email on the request that reaches the app; the app trusts them
# because nothing but this container can reach it (no published ports, private network).
#
# Certificates: ./gateway/tls/ is mounted at /etc/caddy/tls. The base domain's sites import `*.caddy` from it; run.sh writes a self-signed
# certificate there (wildcard.crt, wildcard.key and tls.caddy containing `tls /etc/caddy/tls/wildcard.crt /etc/caddy/tls/wildcard.key`).
# Every extra domain has its own in /etc/caddy/tls/<name>/ (same three files), imported by its generated site. run.sh makes a certificate only
# where none exists, so replace the files of a domain for a real certificate. With nothing in the folder Caddy falls back to its own internal CA
# for non-public names.
{
	email {$ACME_EMAIL}

	# The public port is not 443 (rootless Podman), so there is no point redirecting :80, and HTTP/3 (UDP) is not published.
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}

	# Run the WAF before every other handler (including forward_auth)
	order coraza_waf first
}

(waf) {
	coraza_waf {
		load_owasp_crs
		directives `
			Include @coraza.conf-recommended
			Include @crs-setup.conf.example
			# --- Paper Grader (the app at the bare domain). The app is a JSON API that uses PUT, PATCH and DELETE, takes free text
			# (rubrics, TA feedback) and uploads scans of up to MAX_UPLOAD_MB. CRS's defaults block all of that, so each item below
			# lets exactly one thing through; everything else (URLs, headers, other fields) is still inspected in full. ---
			# CRS 911100 only allows GET HEAD POST OPTIONS. The variable must be set BEFORE the rule files below read it.
			SecAction "id:10030,phase:1,nolog,pass,t:none,setvar:'tx.allowed_methods=GET HEAD POST OPTIONS PUT PATCH DELETE'"
			Include @owasp_crs/*.conf
			SecRuleEngine On
			# False positives: LLDAP's GraphQL query text (e.g. $filters, user( trips SQLi rules.
			# Scoped to LLDAP's GraphQL endpoint and only the JSON "query" field; "variables"
			# (the user-supplied data) is still fully inspected.
			SecRule REQUEST_HEADERS:Host "@rx ^lldap\." "id:10001,phase:1,pass,nolog,chain"
				SecRule REQUEST_URI "@beginsWith /api/graphql" "ctl:ruleRemoveTargetByTag=attack-sqli;ARGS:json.query"
			# CRS 932235 (Unix command injection) matches "addUser" inside the GraphQL mutation name addUserToGroup
			# (adduser is a Unix command), which blocked adding people to groups in the LLDAP UI. Only that rule, only the
			# "query" text field, only on LLDAP's GraphQL endpoint; the "variables" are still fully inspected.
			SecRule REQUEST_HEADERS:Host "@rx ^lldap\." "id:10002,phase:1,pass,nolog,chain"
				SecRule REQUEST_URI "@beginsWith /api/graphql" "ctl:ruleRemoveTargetById=932235;ARGS:json.query"
			# Scan uploads (multipart PDFs/CSVs): CRS buffers the whole body and rejects anything over 13 MB (413), and a PDF's bytes can only
			# produce false positives. Skip body buffering/inspection on exactly the two upload routes; the app enforces the real size limit.
			SecRule REQUEST_URI "@rx ^/api/exams/[0-9]+/imports(/auto-split)?$" "id:10031,phase:1,pass,nolog,ctl:requestBodyAccess=Off"
			# Free text typed by admins and TAs: rubric questions, expected answers and criteria (code, SQL, shell, HTML, maths such as sqrt(
			# and ../ are all legitimate course content), and TA feedback on a grade. Only those JSON fields, only on those routes.
			SecRule REQUEST_URI "@rx ^/api/exams/[0-9]+/(rubrics|rubric\.pdf)$" "id:10032,phase:1,pass,nolog,ctl:ruleRemoveTargetByTag=attack-sqli;ARGS:/^json\.questions\./,ctl:ruleRemoveTargetByTag=attack-xss;ARGS:/^json\.questions\./,ctl:ruleRemoveTargetByTag=attack-rce;ARGS:/^json\.questions\./,ctl:ruleRemoveTargetByTag=attack-lfi;ARGS:/^json\.questions\./,ctl:ruleRemoveTargetByTag=attack-injection-php;ARGS:/^json\.questions\./,ctl:ruleRemoveTargetByTag=attack-injection-generic;ARGS:/^json\.questions\./"
			SecRule REQUEST_URI "@rx ^/api/grades/[0-9]+$" "id:10033,phase:1,pass,nolog,ctl:ruleRemoveTargetByTag=attack-sqli;ARGS:json.final_feedback,ctl:ruleRemoveTargetByTag=attack-xss;ARGS:json.final_feedback,ctl:ruleRemoveTargetByTag=attack-rce;ARGS:json.final_feedback,ctl:ruleRemoveTargetByTag=attack-lfi;ARGS:json.final_feedback,ctl:ruleRemoveTargetByTag=attack-injection-php;ARGS:json.final_feedback,ctl:ruleRemoveTargetByTag=attack-injection-generic;ARGS:json.final_feedback"
		`
	}
}

# Auth portal (login page, Google OAuth callback)
auth.{$DOMAIN} {
	import /etc/caddy/tls/*.caddy

	reverse_proxy tinyauth:3000
}

# User management UI (LLDAP): WAF + Tinyauth gate in front of LLDAP's own login.
lldap.{$DOMAIN} {
	import /etc/caddy/tls/*.caddy

	import waf

	# Only administrators may reach LLDAP at all (LLDAP lets every user edit their own profile, including the email the app uses as
	# the person's identity, so ordinary users get no access to the UI). Administrators are the user ids in LLDAP_ADMIN_USERS: a
	# regex such as `admin` or `admin|alice` (default `admin`); list every account in LLDAP's lldap_admin group. The check uses
	# Remote-User, which Tinyauth sets after login and the client cannot; a missing header matches nothing, so it is denied.
	forward_auth tinyauth:3000 {
		uri /api/auth/caddy
		copy_headers Remote-User Remote-Name Remote-Email
	}

	@lldap_admin header_regexp Remote-User ^({$LLDAP_ADMIN_USERS:admin})$

	handle @lldap_admin {
		reverse_proxy lldap:17170
	}

	handle {
		header Content-Type "text/plain; charset=utf-8"
		respond "User management is for administrators only." 403
	}
}

# The app itself, for every domain it is served on: {args[0]} is the Tinyauth that signs people in on that domain (its cookie belongs to one
# domain, so each extra domain has its own; see EXTRA_DOMAINS in .env.example). run.sh writes the extra sites into /etc/caddy/sites.
(paper_grader) {
	import waf

	forward_auth {args[0]}:3000 {
		uri /api/auth/caddy
		copy_headers Remote-User Remote-Name Remote-Email
	}

	# Scans are large; the app enforces the real per-file limit (MAX_UPLOAD_MB). Stream uploads, long timeouts for exports.
	reverse_proxy web:4321 {
		flush_interval -1
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}
}

# Paper Grader
{$DOMAIN} {
	import /etc/caddy/tls/*.caddy

	import paper_grader tinyauth
}

# Paper Grader on the other domains (generated by run.sh from EXTRA_DOMAINS; empty when there are none)
import /etc/caddy/sites/*.caddy
